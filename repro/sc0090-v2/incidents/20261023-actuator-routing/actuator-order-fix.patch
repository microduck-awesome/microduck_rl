@@ -0,0 +1,38 @@
+"""Check named motor torques at their actual MuJoCo joint destinations on CPU."""
+
+import mujoco
+import numpy as np
+import unittest
+import mjlab.tasks
+from mjlab.entity import Entity
+from mjlab.tasks.registry import load_env_cfg
+
+from mjlab_microduck.custom_v2.sim2real import RISE_TASK, WALK_TASK
+
+
+class ActuatorMappingTest(unittest.TestCase):
+    def test_shared_bus_torques_reach_the_named_joints(self):
+        for task in (RISE_TASK, WALK_TASK):
+            for sort_actuators in (False, True):
+                with self.subTest(task=task, sort_actuators=sort_actuators):
+                    cfg = load_env_cfg(task).scene.entities["robot"]
+                    cfg.sort_actuators = sort_actuators
+                    robot = Entity(cfg)
+                    model = robot.spec.compile()
+                    data = mujoco.MjData(model)
+                    expected = {}
+                    for group in robot.actuators:
+                        # compute(cmd) column order, independently of XML controls.
+                        for column, name in enumerate(group.target_names):
+                            expected[name] = (column + 1) * 0.001
+                        controls = np.array([expected[name] for name in group.target_names])
+                        control_ids = [motor.id for motor in group._mjs_actuators]
+                        data.ctrl[control_ids] = controls
+                    # Forward dynamics only: no integration, GPU, or rollout.
+                    mujoco.mj_forward(model, data)
+                    self.assertEqual(len(expected), 15)
+                    self.assertIn("mouth", expected)
+                    for name, torque in expected.items():
+                        dof = int(model.joint(name).dofadr[0])
+                        self.assertAlmostEqual(data.qfrc_actuator[dof], torque,
+                                               delta=1e-12, msg=name)
