@@ -183,6 +183,12 @@ class SC0090V5Actuator(BamActuator):
 
     def edit_spec(self, spec, target_names):
         super().edit_spec(spec, target_names)
+        # BAM discovers existing motors in XML order, whereas compute(cmd)
+        # columns follow entity joint order. The V2 mouth precedes the right
+        # leg in joint order but is last in the XML actuator block. Align the
+        # control destinations without changing either physical joint order.
+        target_order = {name: i for i, name in enumerate(self.target_names)}
+        self._mjs_actuators.sort(key=lambda motor: target_order[motor.target])
         for actuator in self._mjs_actuators:
             actuator.ctrllimited = self.cfg.official_effort_clamps
             actuator.forcelimited = self.cfg.official_effort_clamps
@@ -194,6 +200,8 @@ class SC0090V5Actuator(BamActuator):
                 actuator.forcerange = (-limit, limit)
 
     def initialize(self, mj_model, model, data, device):
+        if [motor.target for motor in self._mjs_actuators] != list(self.target_names):
+            raise ValueError("SC0090 torque columns must match their named motor targets")
         super().initialize(mj_model, model, data, device)
         self.friction_scale = torch.ones_like(self.kp_scale)
         self.default_friction_scale = self.friction_scale.clone()
diff --git a/tests/test_sc0090_actuator_mapping.py b/tests/test_sc0090_actuator_mapping.py
