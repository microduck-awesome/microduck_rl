"""200Hz physical kick attribution; actor remains blind to privileged ball state."""
import math
import torch

CONTACT_FORCE_MIN_N = .001


def ensure_ball_kick_state(env):
    if not hasattr(env, '_v2_ball_valid_kick'):
        env._v2_ball_valid_kick = torch.zeros(env.num_envs, dtype=torch.bool, device=env.device)
        env._v2_ball_bad_contact = torch.zeros_like(env._v2_ball_valid_kick)


def kick_state_transition(valid, bad, correct_touch, other_touch, head_ground, supported, healthy):
    """Bad contact has precedence, including simultaneous correct/wrong touch."""
    next_bad = bad | other_touch | head_ground
    next_valid = (valid | (correct_touch & supported & healthy)) & ~next_bad
    return next_valid, next_bad


def ball_kick_state_observation(env):
    ensure_ball_kick_state(env)
    return torch.stack((env._v2_ball_valid_kick, env._v2_ball_bad_contact), -1).float()


def reset_ball_with_kick_state(env, env_ids, **params):
    from mjlab_microduck.tasks.mdp import reset_ball_in_front_of_foot
    reset_ball_in_front_of_foot(env, env_ids, **params)
    ensure_ball_kick_state(env)
    ids = slice(None) if env_ids is None else env_ids
    env._v2_ball_valid_kick[ids] = False
    env._v2_ball_bad_contact[ids] = False


def install_ball_kick_state(env, env_ids):
    """Startup hook: read after every native physics substep, before rewards.

    Writes only two explicit Markov-state bits. No reward-side mutation, no
    dynamics/actor edit, and no extra forward/sense call or RNG draw.
    """
    ensure_ball_kick_state(env)
    assert not getattr(env, '_v2_ball_state_installed', False)
    env._v2_ball_state_installed = True
    original = env.metrics_manager.compute_substep
    def touching(name, *, force=False):
        data = env.scene[name].data
        found = data.found.reshape(env.num_envs, -1) > 0
        if force:
            magnitude = data.force.reshape(env.num_envs, -1, 3).norm(dim=-1)
            found &= magnitude > CONTACT_FORCE_MIN_N
        return found.any(-1)
    def update():
        original()
        robot = env.scene['robot']
        quat = robot.data.root_link_quat_w
        upright = 1-2*(quat[:,1].square()+quat[:,2].square())
        healthy = (upright >= math.cos(math.pi/4))
        healthy &= robot.data.root_link_pos_w[:,2]-env.scene.env_origins[:,2] >= .08
        healthy &= torch.isfinite(env.sim.data.qpos).all(-1) & torch.isfinite(env.sim.data.qvel).all(-1)
        healthy &= env._v2_joint_feedback.ready
        valid, bad = kick_state_transition(env._v2_ball_valid_kick, env._v2_ball_bad_contact,
            touching('kick_foot_ball_contact',force=True),
            touching('other_robot_ball_contact',force=True),
            touching('v2_head_ground_contact',force=True),
            touching('support_foot_ground_contact'), healthy)
        env._v2_ball_valid_kick.copy_(valid)
        env._v2_ball_bad_contact.copy_(bad)
    env.metrics_manager.compute_substep = update


def gated_ball_forward_velocity(env, asset_name='ball', max_speed=1.):
    from mjlab_microduck.tasks.mdp import ball_forward_velocity
    assert getattr(env, '_v2_ball_state_installed', False), 'Ball kick attribution must run at physics rate'
    return ball_forward_velocity(env,asset_name=asset_name,max_speed=max_speed)*env._v2_ball_valid_kick


def ball_nonfinite(env):
    """The original robot-only NaN termination does not cover the free ball."""
    ball = env.scene['ball'].data
    return (~torch.isfinite(ball.root_link_pos_w).all(-1)
            | ~torch.isfinite(ball.root_link_quat_w).all(-1)
            | ~torch.isfinite(ball.root_link_lin_vel_w).all(-1)
            | ~torch.isfinite(ball.root_link_ang_vel_w).all(-1))
