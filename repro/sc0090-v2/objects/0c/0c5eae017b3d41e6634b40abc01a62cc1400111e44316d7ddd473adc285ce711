def serial(x):
    if callable(x):return x.__module__+'.'+x.__qualname__
    if isinstance(x,dict):return {str(k):serial(v) for k,v in x.items()}
    if isinstance(x,(list,tuple)):return [serial(v) for v in x]
    return x


torch.set_num_threads(2)
omega=torch.tensor([[1.,2.,3.],[0.,0.,1.],[2.,0.,0.],[-2.,0.,0.]])
torch.testing.assert_close(camera_rotation_cost(omega,torch.tensor([1.,1.,0.,0.])),torch.tensor([9.,0.,4.,4.]),rtol=0,atol=0)
q=torch.zeros(4,4);q[:,0]=1;q[2,0]=math.cos(math.pi/6);q[2,2]=math.sin(math.pi/6)
gate=upright_camera_gate(torch.tensor([.112,.1,.112,.08]),q)
torch.testing.assert_close(gate,torch.tensor([1.,.5,0.,0.]),rtol=0,atol=1e-6)
data=NS(site_ang_vel_w=torch.zeros(2,1,3),root_link_pos_w=torch.tensor([[0.,0.,.112],[0.,0.,.112]]),root_link_quat_w=torch.tensor([[1.,0.,0.,0.],[1.,0.,0.,0.]]))
class Scene(dict):pass
scene=Scene(robot=NS(data=data));scene.env_origins=torch.zeros(2,3)
command=torch.zeros(2,3)
env=NS(scene=scene,num_envs=2,device='cpu',cfg=NS(decimation=4),common_step_counter=10,_sim_step_counter=40,command_manager=NS(get_command=lambda _:command))
asset=NS(name='robot',site_ids=[0]);sampler=V2CameraMotionSamples(NS(per_substep=True,params={'asset_cfg':asset}),env)
for i in range(4):
    data.site_ang_vel_w[:,0,0]=2 if i%2==0 else -2;env._sim_step_counter+=1
    sampler(env,asset);saved=sampler._sum.clone();sampler(env,asset);assert torch.equal(saved,sampler._sum)
env.common_step_counter+=1
torch.testing.assert_close(sampler.read(env),torch.full((2,),4.),rtol=0,atol=0)
command[:,2]=3 # a next-command update cannot relabel the captured interval
torch.testing.assert_close(sampler.read(env),torch.full((2,),4.),rtol=0,atol=0)
sampler.reset(torch.tensor([0]));torch.testing.assert_close(sampler.read(env),torch.tensor([0.,4.]),rtol=0,atol=0)
env.common_step_counter+=1
try:sampler.read(env)
except RuntimeError:pass
else:raise AssertionError('stale interval accepted')
parent=serial(asdict(make_velstand_env_cfg()));candidate=serial(asdict(make_camera_env_cfg()));control=serial(asdict(make_camera_env_cfg(camera_weight=0.)))
for cfg in (candidate,control):
