 with torch.no_grad():cap.std_param[head]=.005
 cap.std_param.grad=None;cap.update(mean);(-cap.entropy.mean()).backward();assert (cap.std_param.grad[head]!=0).all()
 results.append(dict(device=device,status='PASS',leg_samples_bitwise_equal=True,stored_std_effective=True,ratio_one=True,kl_zero=True,scalar_state_keys_unchanged=True,export_identity_unchanged=True,gradient_above_below_cap=True))
