def canonical(x):return re.sub(r'0x[0-9a-fA-F]+','0xADDRESS',json.dumps(asdict(x),sort_keys=True,default=str))
for play in (False,True):
 a=load_env_cfg(LATE_ENTROPY_TASK,play=play);b=load_env_cfg(HEAD_STD_CAP_TASK,play=play)
 assert configure_head_precision_learning(a,5)==configure_head_precision_learning(b,5)
 assert canonical(a)==canonical(b)
a=load_rl_cfg(LATE_ENTROPY_TASK);b=load_rl_cfg(HEAD_STD_CAP_TASK)
