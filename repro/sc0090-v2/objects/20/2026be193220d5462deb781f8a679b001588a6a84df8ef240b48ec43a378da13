"""The complete measurement graph must preserve eager state across partial resets."""
import torch
import pytest
import os
from mjlab_microduck.custom_v2.microduck_v2 import ASSETS
from mjlab_microduck.sc0090_v2.feedback import WholeRobotFeedback


@pytest.mark.skipif(not torch.cuda.is_available(), reason='CUDA unavailable')
@pytest.mark.parametrize('stress', [False, True])
@pytest.mark.parametrize('frontend', ['repair'])
def test_graph_replays_match_eager_measurements_and_all_causal_state(stress,frontend):
    torch.set_num_threads(2)
    stage = 'measured' if stress else 'nominal'
    a = WholeRobotFeedback(ASSETS.parent/'training-assets', 4, device='cuda:0', seed=179,stage=stage,
                          observer_frontend='bench',spike_rejection=False,o0_local_history=True)
    b = WholeRobotFeedback(ASSETS.parent/'training-assets', 4, device='cuda:0', seed=179,stage=stage,
                          compile_stream=os.environ.get('V2_TEST_COMPILED_STREAM') == '1',
                          fuse_registers=os.environ.get('V2_TEST_FUSED_REGISTERS') == '1',
                          reset_graph_chunk=int(os.environ.get('V2_TEST_RESET_GRAPH_CHUNK', '1')),
                          observer_frontend='bench',spike_rejection=False,o0_local_history=True)
    a.graph_enabled = False
    a.compact_reset = False
    a.reset_graph_enabled = False
    pose = torch.linspace(-.12,.12,60,device='cuda:0').reshape(4,15)
    for obj in (a,b):
        obj.reset(torch.arange(4,device='cuda:0'), pose)
    steps = 80 if stress else 40
    invalid_seen = False
    with torch.inference_mode():
        for step in range(steps):
            if step in (12,20,28) or (stress and step == 60):
                for obj in (a,b):
                    ids = [0] if step == 60 else ([1,3] if step != 20 else [1,2,3])
                    obj.reset(torch.tensor(ids,device='cuda:0'), pose)
            q = pose + .02*torch.sin(torch.tensor(step*.05,device='cuda:0'))
            v = torch.ones_like(q)*.2*torch.cos(torch.tensor(step*.05,device='cuda:0'))
            if stress and 31 <= step < 50:
                q = pose+.9*torch.sin(torch.tensor(step*.75,device='cuda:0'))
                v = torch.ones_like(q)*135*torch.cos(torch.tensor(step*.75,device='cuda:0'))
                if step == 39:
                    q[0,2] = float('nan')
            if step%4 == 0:
                for obj in (a,b):
                    obj.command(obj.counts(pose))
            a.advance(q,v);b.advance(q,v)
            invalid_seen |= bool((~a.ready).any())
            for left,right in ((a,b),(a.pipeline,b.pipeline),(a.pipeline.stream,b.pipeline.stream)):
                for name,value in vars(left).items():
                    if isinstance(value,torch.Tensor):
                        torch.testing.assert_close(value,getattr(right,name),rtol=0,atol=0,equal_nan=True,msg=name)
    assert b._graph.capture_count == 1 and b._graph.replays == steps-2
    assert len(b._prehistory_graphs) == (4 if stress else 3)
    assert all(g.captures == (2 if g.chunk_ticks==19 else 1) for g in b._prehistory_graphs.values())
    assert b._prehistory_graphs[('partial',30)].tick_replays == 112
    if b.reset_graph_chunk==19:
        assert b._prehistory_graphs[('partial',30)].replays == 22
    if stress:
        assert invalid_seen, 'Fault/rewarm paths must actually be exercised'
