g=torch.Generator(device=device).manual_seed(991)
normalizer=actor.obs_normalizer
x=torch.randn((384,61),device=device,generator=g)*normalizer._std+normalizer._mean
with torch.inference_mode():
 parts=[];std=[];actions=[];lp=[]
 for chunk in x.split(64):
  y=actor({'actor':chunk},stochastic_output=True);parts.append(actor.output_distribution_params[0].clone());std.append(actor.output_distribution_params[1].clone());actions.append(y);lp.append(actor.get_output_log_prob(y))
 oldmean=torch.cat(parts);oldstd=torch.cat(std);actions=torch.cat(actions);oldlp=torch.cat(lp)
 actor({'actor':x},stochastic_output=True);newmean,newstd=actor.output_distribution_params
 ratio=torch.exp(actor.get_output_log_prob(actions)-oldlp);kl=actor.get_kl_divergence((oldmean,oldstd),(newmean,newstd))
 assert torch.equal(oldstd,newstd)
 r=dict(status='PASS',scope='same learned actor and normalized synthetic inputs, batch64 vs384 recomputation; no physics or learning',mean_max_delta=float((oldmean-newmean).abs().max()),std_exact=True,kl_max=float(kl.max()),ratio_max_error=float((ratio-1).abs().max()))
