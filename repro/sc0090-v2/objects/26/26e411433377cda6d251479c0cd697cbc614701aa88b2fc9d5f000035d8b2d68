agent=asdict(load_rl_cfg(HEAD_STD_CAP_TASK));device='cuda:0';torch.set_num_threads(2)
obs=TensorDict({'actor':torch.zeros(64,61,device=device),'critic':torch.zeros(64,74,device=device)},batch_size=[64])
groups=resolve_obs_groups(obs,agent['obs_groups'],['actor','critic']);cfg=agent['actor']
for opt in ('cnn_cfg','distribution_cfg'):
 if cfg.get(opt) is None:cfg.pop(opt,None)
if cfg.get('rnn_type') is None:
 for opt in ('rnn_type','rnn_hidden_dim','rnn_num_layers'):cfg.pop(opt,None)
actor=resolve_callable(cfg.pop('class_name'))(obs,groups,'actor',14,**cfg).to(device);actor.load_state_dict(state['actor_state_dict'],strict=True);actor.eval()
