"""Standing retention grouped by exact saved reset pitch, not post-step pitch."""
import argparse
import hashlib
import json
from pathlib import Path
import numpy as np

p=argparse.ArgumentParser(__doc__)
p.add_argument('evidence',type=Path)
a=p.parse_args()
cases=[]
for path in sorted(a.evidence.glob('traces-*.npz')):
    raw=np.load(path)
    assert 'initial_qpos' in raw, 'Exact reset quaternion is required; do not infer from first frame'
    mask=raw['bucket']==0
    states=raw['states'][:,mask]
    q=states[:,:,3:7]
    height=states[:,:,2]-raw['env_origins'][mask,2]
    cosine=np.clip(1-2*(q[:,:,1]**2+q[:,:,2]**2),-1,1)
    fall=(((np.arange(len(states))+1)*.02)[:,None]>.2)&(np.degrees(np.arccos(cosine))>45)&(height<.08)
    stable=states[:,:,-2].astype(bool)
    prior=np.concatenate((np.zeros_like(stable[:1]),np.maximum.accumulate(stable,axis=0)[:-1]),axis=0)
    initial=raw['initial_qpos'][mask,3:7]
    w,x,y,z=initial.T
    pitch=np.degrees(np.arcsin(np.clip(2*(w*y-z*x),-1,1)))
    rows=[]
    for low,high in [(-10.001,-5),(-5,0),(0,5),(5,10.001)]:
        choose=(pitch>=low)&(pitch<high)
        rows.append(dict(pitch_bounds_deg=[low,high],trials=int(choose.sum()),
            ever_fell=int((fall.any(0)&choose).sum()),
            fell_before_first_stable=int(((fall&~prior).any(0)&choose).sum()),
            fell_after_any_prior_stable=int(((fall&prior).any(0)&choose).sum()),
            final_stable=int((stable[-1]&~states[-1,:,-1].astype(bool)&choose).sum())))
    assert sum(r['trials'] for r in rows)==len(pitch)
    cases.append(dict(seed=int(path.stem.split('-')[-1]),bins=rows,
                     trace_sha256=hashlib.sha256(path.read_bytes()).hexdigest()))
assert len(cases)==2
totals=[]
for i in range(4):
    row={'pitch_bounds_deg':cases[0]['bins'][i]['pitch_bounds_deg']}
    for key in ('trials','ever_fell','fell_before_first_stable','fell_after_any_prior_stable','final_stable'):
        row[key]=sum(c['bins'][i][key] for c in cases)
    totals.append(row)
report=dict(schema=1,metric='Standing initial bucket, t>.2s, tilt>45deg AND z<.08m; exact reward-time stable flag',
            grouping='Exact reset quaternion pitch, 0.001 deg outer rounding tolerance',
            overlap='A trajectory can fall before and after first stability; these two counts are not disjoint',
            script_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),cases=cases,totals=totals)
(a.evidence/'standing-pitch-bins.json').write_text(json.dumps(report,indent=2))
print(a.evidence,totals)
