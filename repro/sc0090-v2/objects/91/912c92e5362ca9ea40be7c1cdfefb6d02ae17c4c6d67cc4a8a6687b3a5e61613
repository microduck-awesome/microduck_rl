            native_step()
        def metrics():
            before=state();rng=torch.get_rng_state();cuda_rng=torch.cuda.get_rng_state(env.device)
            native_metrics()
            after=state()
            for key in before:torch._assert_async(torch.eq(before[key],after[key]).all(),'Camera metric changed live '+key)
            assert torch.equal(rng,torch.get_rng_state()) and torch.equal(cuda_rng,torch.cuda.get_rng_state(env.device))
            omega[sub[0]].copy_(robot.data.site_ang_vel_w[:,sampler.asset_cfg.site_ids[0]])
            yaw[sub[0]].copy_(env.command_manager.get_command('twist')[:,2])
            height[sub[0]].copy_(robot.data.root_link_pos_w[:,2]-env.scene.env_origins[:,2])
            quat[sub[0]].copy_(robot.data.root_link_quat_w);sub[0]+=1
