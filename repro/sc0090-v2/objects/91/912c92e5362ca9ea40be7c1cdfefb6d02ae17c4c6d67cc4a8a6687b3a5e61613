        np.testing.assert_allclose(sums.cpu().numpy(),expected,atol=2e-5,rtol=2e-6)
        np.testing.assert_allclose(raw_sums.cpu().numpy(),raw_expected,atol=2e-5,rtol=2e-6)
        np.testing.assert_allclose(paid.cpu().numpy(),-.01*expected,atol=2e-6,rtol=2e-6)
        model=env.sim.mj_model;data=mujoco.MjData(model);site=int(robot.data.indexing.site_ids[sampler.asset_cfg.site_ids[0]])
        jp=np.empty((3,model.nv));jr=np.empty_like(jp);max_error=0.
        for step in (0,1,3,4,19,20,39,40,79):
            for world in (0,1,8,31):
                data.qpos[:]=x['qpos'][step,world];data.qvel[:]=x['qvel'][step,world]
                mujoco.mj_kinematics(model,data);mujoco.mj_comPos(model,data);mujoco.mj_jacSite(model,data,jp,jr,site)
                wanted=jr@data.qvel;err=np.max(np.abs(wanted-o[step,world]));max_error=max(max_error,float(err))
                np.testing.assert_allclose(o[step,world],wanted,atol=2e-4,rtol=2e-5)
        old=sampler._sum.clone();ids=torch.tensor([1,3,9],device=env.device);others=torch.ones(32,dtype=torch.bool,device=env.device);others[ids]=False
        with torch.inference_mode():env.reset(env_ids=ids)
        assert torch.equal(sampler._sum[others],old[others]);assert bool((sampler._sum[ids]==0).all())
        for key,value in frozen.items():assert torch.equal(actor.state_dict()[key],value)
        torch.save(dict(qpos=torch.from_numpy(x['qpos']),qvel=torch.from_numpy(x['qvel']),omega=omega.cpu(),yaw=yaw.cpu(),height=height.cpu(),quat=quat.cpu(),gated_interval=sums.cpu(),raw_interval=raw_sums.cpu(),weighted_reward=paid.cpu()),a.output/'trace.pt')
        report=dict(status='PASS_PHYSICS_SAMPLING_NOT_PPO_QUALIFIED',physical_controls=640,formal_controls=0,actual_substeps=80,worlds=32,live_state_rng_unchanged=True,actor_normalizer_unchanged=True,independent_cpu_jacobian_samples=36,independent_cpu_omega_max_abs=max_error,gated_cost_max_abs=float(np.max(np.abs(sums.cpu().numpy()-expected))),raw_cost_max_abs=float(np.max(np.abs(raw_sums.cpu().numpy()-raw_expected))),partial_reset='PASS',scope='Frozen256 deterministic policy and diagnostic command changes; direct substep state noninterference, no long trajectory determinism or improvement claim',script_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest())
        (a.output/'report.json').write_text(json.dumps(report,indent=2)+'\n');print(json.dumps(report),flush=True)
    finally:env.close()


if __name__=='__main__':main()
