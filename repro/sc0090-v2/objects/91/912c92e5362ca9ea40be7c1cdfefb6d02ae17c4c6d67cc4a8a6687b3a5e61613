        native_reward=env.reward_manager.compute
        def reward(dt):
            value=native_reward(dt);sums[control[0]].copy_(sampler.read(env));raw_sums[control[0]].copy_(sampler.read(env,gated=False))
            paid[control[0]].copy_(env.reward_manager._step_reward[:,env.reward_manager.active_terms.index('v2_camera_rotation')]);return value
        env.reward_manager.compute=reward
        with torch.inference_mode():
            for step in range(20):
                control[0]=step
                # Native resampling occurs after this control's reward, so the
                # next actor and the next cost receive the same new command.
                if step in (5,10):env.command_manager.get_term('twist').time_left.fill_(0.)
                obs,*_=env.step(actor(TensorDict(obs,batch_size=[32]),stochastic_output=False))
        assert sub[0]==80
        x={k:v.cpu().numpy() for k,v in arrays.items()};o=omega.cpu().numpy();y=yaw.cpu().numpy();h=height.cpu().numpy();q=quat.cpu().numpy()
        assert np.any(y[24]!=y[20]) and np.any(y[44]!=y[40])
        raw=(o[:,:,:2]**2).sum(-1)+(o[:,:,2]-y)**2
        tilt=np.arccos(np.clip(1-2*(q[:,:,1]**2+q[:,:,2]**2),-1,1))
