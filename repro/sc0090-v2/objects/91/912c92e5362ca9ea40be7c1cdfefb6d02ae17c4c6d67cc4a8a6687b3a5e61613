from mjlab_microduck.custom_v2.camera_stability import make_camera_env_cfg
from mjlab_microduck.custom_v2.velstand import TASK as VELSTAND_TASK


def main():
    p=argparse.ArgumentParser();p.add_argument('--output',type=Path,required=True);a=p.parse_args()
    r=Path(__file__).resolve().parents[1].parent
    assert json.loads((r/'velstand-camera-cpu-002.json').read_text())['status']=='PASS_CPU_ONLY_NOT_GPU_QUALIFIED'
    a.output.mkdir(parents=True,exist_ok=False);(a.output/'executed-script.py').write_bytes(Path(__file__).read_bytes());torch.set_num_threads(2);torch.cuda.set_device('cuda:0')
    cfg=make_camera_env_cfg(play=True);cfg.scene.num_envs=32;cfg.seed=2026101640
    cfg.curriculum={};cfg.terminations={};cfg.auto_reset=False;cfg.observations['actor'].enable_corruption=False
    env=ManagerBasedRlEnv(cfg,device='cuda:0')
    try:
        obs,_=env.reset();robot=env.scene['robot'];sampler=env._v2_camera_motion
        parent=torch.load(r/'velstand-v8-allocation-002/checkpoint_000256.pt',map_location=env.device,weights_only=False)
        agent=asdict(load_rl_cfg(VELSTAND_TASK));td=TensorDict(obs,batch_size=[32]);groups=resolve_obs_groups(td,agent['obs_groups'],['actor','critic']);ac=agent['actor']
        for key in ('cnn_cfg','distribution_cfg'):
            if ac.get(key) is None:ac.pop(key,None)
        if ac.get('rnn_type') is None:
            for key in ('rnn_type','rnn_hidden_dim','rnn_num_layers'):ac.pop(key,None)
        actor=resolve_callable(ac.pop('class_name'))(td,groups,'actor',14,**ac).to(env.device)
        actor.load_state_dict(parent['actor_state_dict'],strict=True);actor.eval();frozen={k:v.clone() for k,v in actor.state_dict().items()}
        arrays={name:torch.empty((80,*getattr(env.sim.data,name).shape),device=env.device) for name in ('qpos','qvel')}
        omega=torch.empty(80,32,3,device=env.device);yaw=torch.empty(80,32,device=env.device)
        height=torch.empty_like(yaw);quat=torch.empty(80,32,4,device=env.device)
        sums=torch.empty(20,32,device=env.device);raw_sums=torch.empty_like(sums);paid=torch.empty_like(sums)
