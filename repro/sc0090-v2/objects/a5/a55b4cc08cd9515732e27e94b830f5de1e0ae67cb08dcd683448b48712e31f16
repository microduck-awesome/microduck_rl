"""Original Roulade reward/reset recipe with sufficient PPO/curriculum exposure.

Retain all qualified V2 geometry and feedback corrections. No endpoint
teacher, extra spawn bucket, reward change, or trajectory is introduced.
"""
from copy import deepcopy
from .roulade import make_roulade_env_cfg, ROULADE_TASK

HISTORY_TASK=ROULADE_TASK.replace('-Repaired-', '-History-Repaired-')
EXPOSURE_FACTOR=4


def make_history_roulade_env_cfg(play=False,stage='nominal'):
    cfg=make_roulade_env_cfg(play=play,stage=stage)
    for term in cfg.curriculum.values():
        for stages in term.params.values():
            if isinstance(stages,list):
                for item in stages:
                    if isinstance(item,dict) and 'step' in item:
                        assert isinstance(item['step'],int) and item['step']%EXPOSURE_FACTOR==0
                        item['step']//=EXPOSURE_FACTOR
    return cfg


def register_history_roulade_tasks():
    from mjlab.tasks.registry import load_rl_cfg,register_mjlab_task
    from mjlab_microduck.tasks import MicroduckOnPolicyRunner
    for suffix,stage in (('','nominal'),('-Measured','measured')):
        agent=deepcopy(load_rl_cfg(ROULADE_TASK+suffix))
        agent.algorithm.num_mini_batches=16
        agent.run_name='history_'+stage
        register_mjlab_task(task_id=HISTORY_TASK+suffix,
            env_cfg=make_history_roulade_env_cfg(stage=stage),
            play_env_cfg=make_history_roulade_env_cfg(play=True,stage=stage),
            rl_cfg=agent,runner_cls=MicroduckOnPolicyRunner)
