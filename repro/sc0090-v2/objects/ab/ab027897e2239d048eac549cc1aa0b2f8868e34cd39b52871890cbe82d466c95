"""Frozen actor/normalizer factorial diagnostic, never a training candidate."""
import importlib.util
import json
from pathlib import Path
import sys
import numpy as np
import evaluate_v2_head_normalizer as evaluation

root=Path('runs-v2/paired-standing20-normalizer-four-arms')
root.mkdir(exist_ok=False,parents=True)
parent=Path('/home/l40-vm01/data2/experiments/microduck-v2-20261015/baseline/paired-feedback-allocation-001/checkpoint_003762.pt')
child=Path('runs-v2/paired-p04-standing20-allocation-001/checkpoint_003890.pt')
summary_path=Path('/home/l40-vm01/data2/experiments/microduck-v2-20261015/baseline/head-foundation-worktree/scripts/summarize_v2_head_saved.py')
spec=importlib.util.spec_from_file_location('head_summary',summary_path)
summary=importlib.util.module_from_spec(spec);spec.loader.exec_module(summary);summary.guard()
report=dict(scope='Frozen deterministic policies, actor network and observation-normalizer 2x2 ablation; no optimizer or checkpoint writes',
            task='Mjlab-StandUp-Flat-MicroDuck-V2-PairedAdapt-Standing20-Repaired-S0-O0-R1',arms=[])
for label,actor,norm in [('parent_parent',parent,parent),('parent_child',parent,child),
                         ('child_parent',child,parent),('child_child',child,child)]:
    folder=root/label
    sys.argv=['evaluate_v2_head_normalizer.py','--task',report['task'],'--checkpoint',str(actor),
              '--normalizer-checkpoint',str(norm),'--output',str(folder),'--device','cuda:1',
              '--repeats','8','--randomization-stage','measured']
    evaluation.main()
    metrics=summary.summarize(folder/'report.json','cpu')
    (folder/'simultaneous-metrics.json').write_text(json.dumps(metrics,indent=2))
    report['arms'].append(dict(label=label,actor_checkpoint=str(actor.resolve()),
                              normalizer_checkpoint=str(norm.resolve()),summary=metrics['summary']))
    (root/'progress.json').write_text(json.dumps(report,indent=2))
    print(label,metrics['summary'],flush=True)
pairing=[]
for seed in (2026101503,2026101504):
    base=np.load(root/'parent_parent'/f'traces-{seed}.npz')
    for arm in report['arms'][1:]:
        other=np.load(root/arm['label']/f'traces-{seed}.npz')
        same={k:bool(np.array_equal(base[k],other[k])) for k in
              ('initial_qpos','initial_qvel','initial_actor_obs','env_origins')}
        pairing.append(dict(seed=seed,arm=arm['label'],equal=same))
report['initial_pairing']=pairing
report['initial_pairing_pass']=all(all(row['equal'].values()) for row in pairing)
(root/'report.json').write_text(json.dumps(report,indent=2))
assert report['initial_pairing_pass'], 'Initial-state pairing failed; do not call this a paired ablation'
