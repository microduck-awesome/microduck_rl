"""Metric semantics that can silently make a fallen walker appear successful."""
import importlib.util
from pathlib import Path
import torch
from mjlab_microduck.custom_v2.walking_metrics import failure_mask, exposure_masks

spec=importlib.util.spec_from_file_location('walk_eval',Path(__file__).resolve().parents[1]/'scripts/evaluate_v2_walking.py')
module=importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)


def test_failure_is_latched_even_after_physical_recovery():
    h=torch.tensor([[.112,.112],[.079,.112],[.112,.112]])
    tilt=torch.tensor([[0.,0.],[0.,1.],[0.,0.]])
    valid=torch.ones_like(h,dtype=torch.bool)
    raw=failure_mask(h,tilt,valid,valid)
    assert raw.tolist()==[[False,False],[True,True],[False,False]]
    assert raw.cummax(0).values[-1].tolist()==[True,True]


def test_command_counts_partition_by_executed_command():
    command=torch.tensor([[0.,0.,0.],[0.,0.,1.],[.2,0.,0.],[.2,0.,-.7]])
    head=torch.tensor([[0.,0.,0.,0.],[.05,0.,0.,0.],[.05,0.,.07,0.],[.05,.05,.07,.015]])
    mask=exposure_masks(command,head)
    assert mask[:,:4].sum(0).tolist()==[1,1,1,1]
    assert mask[:,10:].sum(0).tolist()==[1,1,1,1]
    assert mask.sum(0)[4:10].tolist()==[2,0,0,0,1,1]


def test_response_requires_contiguous_hold_and_no_previous_failure():
    error=torch.ones(30,4,3)
    error[5:15,0]=0  # First qualifying sample is post-control 6 -> .12s.
    error[::2,1]=0  # Isolated crossings do not count.
    error[:,2:]=0
    failed=torch.zeros(30,4,dtype=torch.bool)
    failed[:,2]=True
    arrival=module.sustained_arrival(error,torch.zeros(4,3),failed)
    torch.testing.assert_close(arrival[[0,3]],torch.tensor([.12,.02]))
    assert torch.isinf(arrival[1:3]).all()


def test_actor_command_switches_on_exact_control_boundaries():
    target=torch.tensor([[.2,0.,.7]])
    for i,scale in [(0,0),(49,0),(50,1),(149,1),(150,0),(199,0),(200,-1),(299,-1),(300,0)]:
        assert torch.equal(module.command_for(i,target),target*scale)
