"""Boundary and optimizer/teacher persistence checks before GPU admission."""
from copy import deepcopy
from dataclasses import asdict
import json,math,pathlib,time
import torch
from tensordict import TensorDict
from rsl_rl.models import MLPModel
from rsl_rl.storage import RolloutStorage
from mjlab.tasks.registry import load_env_cfg,load_rl_cfg
from mjlab_microduck.custom_v2.velstand import TASK,SIT_POSE,SIT_HEIGHT
from mjlab_microduck.custom_v2.velstand_ppo import VelStandPPO,teacher_masks
