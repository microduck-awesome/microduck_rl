import pytest,torch
from mjlab_microduck.custom_v2.microduck_v2 import ASSETS
from mjlab_microduck.sc0090_v2.artifacts import TrainingArchive
from mjlab_microduck.sc0090_v2.measurement.stream import CausalStream

COUNTS=[0.,13.,19.,20.,512.,1001.,1002.,1023.,-1.,1024.,float('nan'),512.]

def make(cls,device):
 a=TrainingArchive.load(ASSETS.parent/'training-assets')
 return cls(len(COUNTS),a.weight_path,'O0',device=device,zero=512.,q_limits=(-3.,3.),spike_rejection=False,o0_local_history=True)

def step(s,i,device,check_ready=True):
 t=1_000_000+i*10_000
 if device.startswith('cuda'):
  t=torch.full((len(COUNTS),),t,dtype=torch.int64,device=device)
 count=torch.tensor(COUNTS,device=device);valid=torch.ones(len(COUNTS),device=device,dtype=torch.bool);valid[-1]=False
 s.command(t,512.);s.pid(t,15.)
 _,status=s.read(t-1000,t,t,count,torch.zeros_like(count),torch.zeros_like(count),torch.full_like(count,111.),valid=valid)
 torch.testing.assert_close(status,torch.tensor([0]*8+[-1]*4,device=device),rtol=0,atol=0)
 value,ready=s.tick(t,t,t+1000)
 if i>=4 and check_ready:
  assert ready[:8].all() and not ready[8:].any()
 if i>=7 and check_ready:
  q,good=s.query(t-20000,t+1000)
  assert good[:8].all() and not good[8:].any()
 return value,ready

def test_native_feedback_is_separate_from_goal_guard_cpu():
 torch.set_num_threads(2);s=make(CausalStream,'cpu')
 assert s.count_limits==(20,1001) and s.raw_count_limits==(0,1023)
 for i in range(20):step(s,i,'cpu')
 # A repeated timestamp remains rejected independently of position bounds.
 _,status=s.read(1_189_000,1_190_000,1_191_000,13.,0.,0.,111.)
 assert ((status==-4)|(status==-99)).all()

@pytest.mark.skipif(not torch.cuda.is_available(),reason='CUDA unavailable')
def test_native_boundary_gpu_compiled_all_causal_state():
 torch.set_num_threads(2);torch.cuda.set_device(0)
 from mjlab_microduck.sc0090_v2.measurement.compiled_stream import CompiledCausalStream
 a,b=make(CausalStream,'cuda:0'),make(CompiledCausalStream,'cuda:0')
 for i in range(24):
  if i==12:
   ids=torch.tensor([1,4,9],device='cuda:0');a.reset(ids);b.reset(ids)
  with torch.inference_mode():x=step(a,i,'cuda:0',not 12<=i<19);y=step(b,i,'cuda:0',not 12<=i<19)
  for name,value in vars(a).items():
   if isinstance(value,torch.Tensor):torch.testing.assert_close(value,getattr(b,name),rtol=0,atol=0,equal_nan=True,msg=name)
