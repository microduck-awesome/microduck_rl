"""B0: identical GroundPick physics/task, official continuous action and joint DR.

This is simulation pretraining. It has no P04 feedback readiness or native-count
command execution. The full P04 runtime remains the common transfer assessment.
"""
from copy import deepcopy
from .ground_pick_history import make_history_ground_pick_env_cfg,HISTORY_TASK
from . import microduck_v2 as v2

BASELINE_TASK='Mjlab-GroundPick-Flat-MicroDuck-V2-Official-Baseline-B0'
SENSOR_CHAIN='baseline-official-noise-delay'


def mark_baseline_contract(env,env_ids):
    from mjlab.envs.mdp.actions import JointPositionActionCfg
    from mjlab_microduck.actuator.sc0090_v5 import SC0090V5Actuator
    assert type(env.cfg.actions['joint_pos']) is JointPositionActionCfg
    assert not hasattr(env,'_v2_joint_feedback'), 'B0 must not install a P04 measurement stream'
    assert 'sc0090_feedback_fault' not in env.cfg.terminations
    assert all(isinstance(a,SC0090V5Actuator) for a in env.scene['robot'].actuators)
    assert hasattr(env,'_v2_episode_reset')
    env._v2_ground_pick_baseline=True
    env._v2_sensor_chain=SENSOR_CHAIN


def make_baseline_ground_pick_env_cfg(play=False):
    from mjlab.managers import EventTermCfg
    from mjlab.envs.mdp.actions import JointPositionActionCfg
    from mjlab_microduck.tasks.microduck_ground_pick_env_cfg import make_microduck_ground_pick_env_cfg
    # Retain the verified task's actual V2 full-contact entity, motor parameters,
    # reward, phase/payload, low-reset exposure, curriculum and physical seconds.
    cfg=make_history_ground_pick_env_cfg(play=play,stage='nominal')
    official=make_microduck_ground_pick_env_cfg(play=play,rough=False)
    assert type(official.actions['joint_pos']) is JointPositionActionCfg
    cfg.actions['joint_pos']=deepcopy(official.actions['joint_pos'])
    cfg.actions['joint_pos'].actuator_names=v2.POLICY_JOINTS
    cfg.actions['joint_pos'].preserve_order=True
    assert cfg.actions['joint_pos'].scale==1. and cfg.actions['joint_pos'].use_default_offset
    for group in ('actor','critic'):
        for name in ('joint_pos','joint_vel'):
            cfg.observations[group].terms[name]=deepcopy(official.observations[group].terms[name])
    cfg.events['encoder_bias']=deepcopy(official.events['encoder_bias'])
    cfg.events['mouth_hold']=EventTermCfg(func=v2.hold_mouth,mode='step')
    cfg.events['baseline_contract']=EventTermCfg(func=mark_baseline_contract,mode='startup')
    cfg.terminations.pop('sc0090_feedback_fault')
    # This changes selectors only; mouth remains the independent zero-HOME channel.
    v2._policy_selectors(cfg)
    return cfg


def register_baseline_ground_pick_task():
    from mjlab.tasks.registry import register_mjlab_task,load_rl_cfg
    from mjlab_microduck.tasks import MicroduckOnPolicyRunner
    agent=load_rl_cfg(HISTORY_TASK)
    agent.experiment_name='microduck_v2_groundpick_baseline_b0'
    agent.run_name='groundpick_baseline_b0'
    register_mjlab_task(task_id=BASELINE_TASK,
        env_cfg=make_baseline_ground_pick_env_cfg(),
        play_env_cfg=make_baseline_ground_pick_env_cfg(play=True),
        rl_cfg=agent,runner_cls=MicroduckOnPolicyRunner)
